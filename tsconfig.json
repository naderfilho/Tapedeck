{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tapedeck/core": ["packages/core/src/index.ts"],
      "@tapedeck/core/*": ["packages/core/src/*"],
      "@tapedeck/indicators": ["packages/indicators/src/index.ts"],
      "@tapedeck/data": ["packages/data/src/index.ts"],
      "@tapedeck/store": ["packages/store/src/index.ts"],
      "@tapedeck/report": ["packages/report/src/index.ts"],
      "@tapedeck/cli": ["packages/cli/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/*/src/**/*.ts",
    "examples/*/test/**/*.ts",
    "bench/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"
  ]
}
