{
  "name": "tapedeck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Event-driven backtesting and paper trading engine for TypeScript",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Nader Filho <ndr.dev@outlook.com>",
  "homepage": "https://github.com/naderfilho/Tapedeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naderfilho/Tapedeck.git"
  },
  "bugs": {
    "url": "https://github.com/naderfilho/Tapedeck/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node bench/replay.bench.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "fixtures": "node scripts/fetch-fixtures.ts",
    "venues": "node scripts/venue-compare.ts",
    "site": "node demo/build.ts",
    "site:build": "pnpm -r build && node examples/sma-crossover/src/main.ts && node scripts/venue-compare.ts && node bench/replay.bench.ts > bench.txt && node demo/build.ts",
    "site:serve": "node demo/serve.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tapedeck/core": "workspace:*",
    "@tapedeck/data": "workspace:*",
    "@tapedeck/indicators": "workspace:*",
    "@tapedeck/report": "workspace:*",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
