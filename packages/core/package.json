  "homepage": "https://github.com/naderfilho/Tapedeck/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naderfilho/Tapedeck.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/naderfilho/Tapedeck/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
