{
  "name": "@tapedeck/store",
  "version": "0.1.0",
  "description": "Optional persistence for Tapedeck on node:sqlite: bar cache, run history, paper-trading state",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tapedeck/core": "workspace:*",
    "@tapedeck/data": "workspace:*"
  },
  "sideEffects": false
}
