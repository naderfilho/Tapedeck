{
  "name": "@tapedeck/data",
  "version": "0.1.0",
  "description": "Data providers for Tapedeck: CSV, Binance, and the columnar .tape format",
  "keywords": [
    "market-data",
    "binance",
    "b3",
    "csv",
    "columnar",
    "time-series"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Nader Filho <ndr.dev@outlook.com>",
  "homepage": "https://github.com/naderfilho/Tapedeck/tree/main/packages/data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naderfilho/Tapedeck.git",
    "directory": "packages/data"
  },
  "bugs": {
    "url": "https://github.com/naderfilho/Tapedeck/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tapedeck/core": "workspace:*",
    "zod": "^4.1.13"
  },
  "sideEffects": false
}
